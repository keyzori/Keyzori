{
	"name": "keyzori-workspace",
	"version": "0.4.2",
	"license": "Apache-2.0",
	"description": "Self-hosted software license management server with an operator CLI.",
	"author": "Keyzori contributors",
	"keywords": [
		"keyzori",
		"licensing",
		"software-licensing",
		"license-manager",
		"license-server",
		"license-key",
		"subscriptions",
		"usage-based-licensing",
		"device-limits",
		"concurrent-sessions",
		"self-hosted",
		"open-source",
		"foss",
		"typescript",
		"bun",
		"elysia",
		"postgresql",
		"redis",
		"drizzle-orm",
		"sdk",
		"cli"
	],
	"packageManager": "bun@1.4.2",
	"type": "module",
	"private": true,
	"scripts": {
		"setup": "bun install --frozen-lockfile && bun run db:migrate",
		"dev": "turbo run dev --filter=keyzori-server",
		"dev:server": "turbo run dev --filter=keyzori-server",
		"dev:server:binary": "bun run build:server && bun run server",
		"start": "turbo run start --filter=keyzori-server",
		"server": "turbo run start --filter=keyzori-server",
		"cli": "bun run --cwd apps/server cli",
		"cli:help": "bun run --cwd apps/server cli --help",
		"cli:binary": "bun run --cwd apps/server cli:binary",
		"build": "turbo run build",
		"build:server": "turbo run build --filter=keyzori-server",
		"smoke:packages": "bun run cli:binary --help",
		"test": "bun test apps tests",
		"test:coverage:core": "bun test --config bunfig.coverage.toml --coverage apps/server/src/test/AdminService.test.ts apps/server/src/test/LicenseService.test.ts apps/server/src/test/ActivityService.test.ts",
		"test:server": "bun run --cwd apps/server test",
		"test:cli": "bun test apps/server/src/test/cli.test.ts",
		"typecheck": "turbo run typecheck && bunx tsc --project tests/tsconfig.json",
		"check": "bun run typecheck && bun run test && bun run test:coverage:core && bun run release:verify && bun run lint",
		"check:server": "bun run --cwd apps/server typecheck && bun run test:server",
		"check:cli": "bun run --cwd apps/server typecheck && bun run test:cli",
		"db:generate": "bun run --cwd apps/server db:generate",
		"db:check": "bun run --cwd apps/server db:check",
		"db:migrate": "bun run --cwd apps/server db:migrate",
		"db:push": "bun run --cwd apps/server db:push",
		"db:studio": "bun run --cwd apps/server db:studio",
		"docker:build": "docker build --file apps/server/Dockerfile --tag keyzori-license-server .",
		"docker:build:server": "bun run docker:build",
		"release": "bun run scripts/release.ts",
		"release:sync": "bun run scripts/syncVersions.ts",
		"release:tag": "bun run scripts/tag.ts",
		"release:verify": "bun run scripts/verifyRelease.ts",
		"lint": "bunx @biomejs/biome check .",
		"format": "bunx @biomejs/biome format --write .",
		"audit": "bun audit --audit-level=high",
		"prepare": "husky"
	},
	"workspaces": [
		"apps/server"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/bun": "1.4.2",
		"@types/node": "26.5.0",
		"husky": "^9.1.7",
		"turbo": "2.10.12",
		"typescript": "7.0.2"
	}
}
