{
	"name": "keyzori",
	"version": "2.0.2",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "Self hosted software licensing",
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "bun --watch src/main.ts",
		"start": "bun src/main.ts",
		"master-key": "bun src/main.ts master-key",
		"check": "bun run typecheck && bun run lint && bun run db:check && bun run test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun src/scripts/test-services.ts exec bun test",
		"test:unit": "bun test src/tests/unit",
		"db:generate": "bunx --bun drizzle-kit generate --config=src/drizzle.config.ts",
		"db:migrate": "bun src/main.ts migrate",
		"db:check": "bun src/scripts/check-migrations.ts",
		"openapi": "bun src/scripts/openapi.ts",
		"build": "bun run openapi && bun src/scripts/build.ts",
		"build:verify": "bun src/scripts/verify-build.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@commitlint/types": "21.2.0",
		"@types/bun": "1.4.2",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"@elysia/openapi": "2.0.0-beta.4"
	},
	"dependencies": {
		"@elysia/cors": "2.0.0-beta.1",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"elysia": "2.0.0-beta.16",
		"exact-mirror": "1.2.6",
		"typebox": "1.3.0"
	}
}
