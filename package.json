{
	"name": "keyzori",
	"version": "3.0.0-beta.2",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "Internal licence-key management for developer integrations",
	"packageManager": "bun@1.4.4-canary.20261022.1",
	"engines": {
		"bun": ">=1.4.4-canary.1"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "bun --watch src/main.ts",
		"start": "bun src/main.ts",
		"master-key": "bun src/main.ts master-key",
		"check": "bun src/scripts/check.ts",
		"doctor": "bun src/scripts/doctor.ts",
		"typecheck": "tsc --noEmit",
		"lint": "bun lint --no-script --max-warnings 0",
		"lint:workflows": "actionlint -color",
		"format": "bun fmt --no-script",
		"fmt": "bun fmt --no-script",
		"format:check": "bun fmt --no-script --check",
		"test": "bun src/scripts/test-services.ts exec bun test",
		"test:unit": "bun test src/tests/unit",
		"db:generate": "bunx --bun drizzle-kit generate --config=src/drizzle.config.ts",
		"db:migrate": "bun src/main.ts migrate",
		"db:check": "bun src/scripts/test-services.ts exec bun src/scripts/check-migrations.ts",
		"openapi": "bun src/scripts/openapi.ts",
		"smoke:source": "bun src/scripts/test-services.ts exec bun src/scripts/source-smoke.ts",
		"smoke:container": "bun src/scripts/test-services.ts exec bun src/scripts/container-smoke.ts",
		"smoke:compose": "bun src/scripts/compose-smoke.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@commitlint/types": "21.2.3",
		"@types/bun": "1.4.4",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"@elysia/openapi": "2.0.0-beta.4"
	},
	"dependencies": {
		"@elysia/cors": "2.0.0-beta.1",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"elysia": "2.0.0-beta.16",
		"exact-mirror": "1.2.7",
		"typebox": "1.4.4"
	}
}
