# Bun >= 1.3.14, PostgreSQL, Redis. Use a fresh database.
# Generate a random admin key: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
KEYZORI_ADMIN_KEY=replace_with_at_least_32_random_characters
KEYZORI_DATABASE_URL=postgresql://keyzori:replace_with_url_safe_password@127.0.0.1:5432/keyzori
KEYZORI_REDIS_URL=redis://127.0.0.1:6379
KEYZORI_HOST=0.0.0.0
KEYZORI_PORT=3000
KEYZORI_SESSION_TTL=60
KEYZORI_ACTIVITY_RETENTION_DAYS=30
KEYZORI_RATE_LIMIT=120
# Exact proxy IPs or CIDRs. Only X-Forwarded-For is used, right to left.
KEYZORI_TRUSTED_PROXIES=
# None enabled by default; names are loaded alphabetically.
KEYZORI_PLUGINS=
# CLI only; it does not connect to PostgreSQL or Redis.
KEYZORI_URL=http://127.0.0.1:3000
# Compose supplies container URLs; the URLs above are for running Bun directly.
# PostgreSQL password must be URL-safe. Dependencies are not exposed to the host.
KEYZORI_POSTGRES_PASSWORD=replace_with_url_safe_password
# Compose binds the API to localhost by default.
KEYZORI_BIND_ADDRESS=127.0.0.1
# Optional prebuilt image: use docker compose up --no-build after pulling it.
# KEYZORI_IMAGE=ghcr.io/keyzori/keyzori:latest
