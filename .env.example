# Bun >= 1.3.14, PostgreSQL 18, Redis 8. Use a fresh database.
#
# Copy this file to .env and generate a random 32+ character admin key:
# bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'

# ============================================================================
# REQUIRED: Admin API Key (min 32 characters, URL-safe recommended)
#
KEYZORI_ADMIN_KEY=replace_with_at_least_32_random_characters

# ============================================================================
# DATABASE: PostgreSQL connection
#
# The password must be URL-safe (no @, /, ?, #, etc.)
# In compose: postgres service uses KEYZORI_POSTGRES_PASSWORD env var
KEYZORI_DATABASE_URL=postgresql://keyzori:replace_with_url_safe_password@127.0.0.1:5432/keyzori
KEYZORI_POSTGRES_PASSWORD=replace_with_url_safe_password

# ============================================================================
# CACHE: Redis connection
KEYZORI_REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# SERVER: Host & port binding
KEYZORI_HOST=0.0.0.0
KEYZORI_PORT=3000
KEYZORI_BIND_ADDRESS=127.0.0.1

# ============================================================================
# SESSION & ACTIVITY
KEYZORI_SESSION_TTL=60
KEYZORI_ACTIVITY_RETENTION_DAYS=30

# ============================================================================
# RATE LIMITING: requests per minute per IP
KEYZORI_RATE_LIMIT=120

# ============================================================================
# PROXIES: Set if behind reverse proxy (nginx, Caddy, etc.)
# Format: exact IPs or CIDR ranges, comma-separated (right-to-left order)
# Example: KEYZORI_TRUSTED_PROXIES=10.0.0.1,192.168.0.0/24
KEYZORI_TRUSTED_PROXIES=

# ============================================================================
# PLUGINS: Comma-separated plugin names (loaded alphabetically)
# Examples: KEYZORI_PLUGINS=stripe,custom-plugin
KEYZORI_PLUGINS=

# ============================================================================
# CLI: Public URL (used by CLI/admin commands, not the server)
KEYZORI_URL=http://127.0.0.1:3000

# ============================================================================
# DOCKER IMAGE: Optional prebuilt image
# Uncomment and set to use prebuilt images instead of building locally
# KEYZORI_IMAGE=ghcr.io/keyzori/keyzori:latest
