# Generate with: bun run master-key. Never share the environment master key.
KZ_MASTER_KEY=
# Compose bootstrap passwords: use separate 32-byte random hexadecimal values.
KZ_POSTGRES_PASSWORD=
KZ_SERVER_DATABASE_PASSWORD=
KZ_MIGRATION_DATABASE_PASSWORD=

# Direct source execution. Serving only verifies history; migrate explicitly.
KZ_DATABASE_URL=postgresql://keyzori_server:password@127.0.0.1:5432/keyzori
KZ_MIGRATION_DATABASE_URL=postgresql://keyzori_migrator:password@127.0.0.1:5432/keyzori
KZ_REDIS_URL=redis://127.0.0.1:6379
KZ_API_HOST=127.0.0.1
KZ_API_PORT=6284
KZ_DATABASE_POOL_SIZE=10
KZ_LOG_LEVEL=info
KZ_TRUSTED_PROXIES=
KZ_CLIENT_IP_HEADERS=

# Separate 32-byte random hexadecimal encryption key; back it up with the database.
# Required for webhook secret creation/decryption and delivery; other APIs still work.
KZ_WEBHOOK_ENCRYPTION_KEY=
# Optional comma-separated HTTPS origins. Empty permits public HTTPS destinations.
# This further restricts destinations; it does not itself permit private addresses.
KZ_WEBHOOK_ALLOWED_ORIGINS=
# Optional operator-only JSON: exact origins AND actual destination CIDRs must match.
# KZ_WEBHOOK_PRIVATE_DESTINATIONS='[{"origin":"https://hooks.internal:8443","cidrs":["10.20.0.0/24"]}]'
# HTTP needs its own explicit origin/CIDR rule. Redirects remain forbidden.
KZ_WEBHOOK_PRIVATE_DESTINATIONS=
# Optional exact browser origins. Server WebSocket clients may omit Origin.
KZ_STREAM_ORIGINS=
KZ_MAX_IN_FLIGHT=128
KZ_PEER_REQUESTS_PER_MINUTE=600
KZ_MAX_STREAMS=100

# Bounded background maintenance. Times are milliseconds; retry max must be >= base.
KZ_MAINTENANCE_RESET_ROWS=100
KZ_MAINTENANCE_RESET_TIME_MS=5000
KZ_MAINTENANCE_CLEANUP_ROWS=1000
KZ_MAINTENANCE_CLEANUP_TIME_MS=5000
KZ_MAINTENANCE_OBSERVATION_TIME_MS=1000
KZ_MAINTENANCE_RETRY_BASE_MS=60000
KZ_MAINTENANCE_RETRY_MAX_MS=3600000
# Optional 1..3650 days. Empty retains events indefinitely; audit and accepted usage
# identity are retained independently. Only a safely processed published prefix expires.
KZ_EVENT_RETENTION_DAYS=

# x-release-please-start-version
KZ_VERSION=3.0.0-beta.1
# x-release-please-end
