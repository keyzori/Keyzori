# Generate with: bun run master-key
KZ_MASTER_KEY=
# Compose-only URL-safe password. Generate 32 random bytes as hex.
KZ_POSTGRES_PASSWORD=
KZ_SERVER_DATABASE_PASSWORD=

# Direct source/binary execution requires both URLs. Compose supplies its own.
KZ_DATABASE_URL=postgresql://keyzori_server:password@127.0.0.1:5432/keyzori
KZ_REDIS_URL=redis://127.0.0.1:6379
KZ_API_HOST=0.0.0.0
KZ_API_PORT=6284
KZ_DATABASE_POOL_SIZE=10
KZ_LOG_LEVEL=info
KZ_TRUSTED_PROXIES=
KZ_CLIENT_IP_HEADERS=

KZ_VERSION=2.0.0
