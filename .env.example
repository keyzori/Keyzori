# Compose only needs these two secrets. Generate a different value for each:
# bun -e 'console.log(crypto.randomUUID().replaceAll("-", "")+crypto.randomUUID().replaceAll("-", ""))'
KEYZORI_ADMIN_KEY=replace_with_at_least_32_random_characters
KEYZORI_POSTGRES_PASSWORD=replace_with_url_safe_password

# Run: docker compose up --build -d
# API: http://localhost:6284 (container port 6284)
# Compose supplies PostgreSQL and Redis URLs automatically.

# Running Bun directly instead of Compose? Set your existing services here:
# KEYZORI_DATABASE_URL=postgresql://keyzori:password@127.0.0.1:5432/keyzori
# KEYZORI_REDIS_URL=redis://127.0.0.1:6379

# Optional settings are read directly from .env. Defaults live in the server.
# KEYZORI_SESSION_TTL=60
# KEYZORI_ACTIVITY_RETENTION_DAYS=30
# KEYZORI_RATE_LIMIT=120
# KEYZORI_TRUSTED_PROXIES=10.0.0.1
# KEYZORI_PLUGINS=stripe
# External admin CLI only: set KEYZORI_URL=http://127.0.0.1:6284 in its environment.
